# ==============================================================================
# ZEC CAMPUS HUB — ENVIRONMENT CONFIGURATION
# ZERO EXCLUSION CARBON POVERTY - Campus Club ISIMS
# ==============================================================================

# Supabase Public API URL (from Supabase Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anon / Publishable Key (safe for browser exposure with RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key-here

# Optional: Production Site URL (used for Auth callback redirects and webhooks)
# Example: https://3-z-isims.vercel.app
NEXT_PUBLIC_SITE_URL=https://your-production-domain.vercel.app

# Supabase Service Role Key (SERVER ONLY, NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key-here

# ==============================================================================
# MEETING BAAS API V2 CONFIGURATION (Meeting recording & transcription)
# Docs: https://docs.meetingbaas.com/api-v2
# Base URL: https://api.meetingbaas.com/v2
# ==============================================================================
MEETING_BAAS_API_KEY=your-meeting-baas-api-key-here
MEETING_BAAS_WEBHOOK_SECRET=whsec_your-svix-webhook-secret-here

# ==============================================================================
# AI MEETING INTELLIGENCE PROVIDER
# Supported: 'openai' or 'gemini'
# ==============================================================================
AI_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here
AI_MODEL=gpt-4o-mini

# ==============================================================================
# RECORDING STORAGE CONFIGURATION
# ==============================================================================
MEETING_RECORDINGS_BUCKET=meeting-recordings

# Resend Email Delivery (Optional)
RESEND_API_KEY=re_your_api_key_here
