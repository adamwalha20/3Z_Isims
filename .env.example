# Supabase Public API URL (from Supabase Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anon / Publishable Key (safe for browser exposure with RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key-here

# Optional: Supabase Service Role Key (SERVER ONLY, NEVER expose to client)
# Used only for initial admin provisioning scripts if needed
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
